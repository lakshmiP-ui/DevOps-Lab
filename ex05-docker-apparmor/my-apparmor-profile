#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Start from "allow", then deny the sensitive things
  file,
  network,
  capability,
  umount,

  # Needed so Docker can stop the container
  signal (receive) peer=unconfined,
  signal (send,receive) peer=my-apparmor-profile,
  ptrace (trace,read,tracedby,readby) peer=my-apparmor-profile,

  # Deny access to sensitive system files
  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /var/** w,

  # Deny execution of binaries in /bin and /usr/bin
  deny /bin/** x,
  deny /usr/bin/** x,

  # Capability restrictions
  deny capability sys_admin,
}
