pipeline {
    agent any

    stages {
        stage('Pre-check Docker') {
            steps {
                sh '''
                docker --version
                docker info > /dev/null
                echo "Docker is available and the daemon is running"
                '''
            }
        }
        stage('Setup Workspace') {
            steps {
                sh '''
                echo "Workspace: $WORKSPACE"
                ls -l ex06-grafana-monitoring
                '''
            }
        }
        stage('Build Docker Images') {
            steps {
                dir('ex06-grafana-monitoring') {
                    sh '''
                    docker build -t delivery_metrics .
                    docker build -t delivery_prometheus -f Dockerfile.prometheus .
                    '''
                }
            }
        }
        stage('Clean Up Old Containers') {
            steps {
                sh 'docker rm -f delivery_metrics prometheus grafana || true'
            }
        }
        stage('Run Application') {
            steps {
                sh 'docker run -d -p 8000:8000 --name delivery_metrics delivery_metrics'
            }
        }
        stage('Run Prometheus and Grafana') {
            steps {
                sh '''
                docker run -d --name prometheus -p 9090:9090 delivery_prometheus
                docker run -d --name grafana -p 3000:3000 grafana/grafana
                '''
            }
        }
        stage('Verify Services') {
            steps {
                sh '''
                for i in $(seq 1 12); do
                  if curl -sf http://host.docker.internal:8000/metrics | grep -q total_deliveries; then
                    echo "Metrics endpoint is up"
                    break
                  fi
                  echo "Waiting for metrics endpoint..."
                  sleep 5
                done
                curl -s http://host.docker.internal:8000/metrics | grep deliveries
                sleep 15
                curl -s http://host.docker.internal:9090/api/v1/targets | grep -o '"health":"[a-z]*"'
                docker ps
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! Prometheus: http://localhost:9090  Grafana: http://localhost:3000'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}